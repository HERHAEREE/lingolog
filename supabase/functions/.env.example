# Edge Function runtime only. Copy to .env for local testing; never commit secrets.
# Production: set in Dashboard > Edge Functions > Secrets.
CORRECTION_MODE=disabled
LINGOLOG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Hosted Supabase injects SUPABASE_URL and server-only service credentials.
# Model calls require all of these and CORRECTION_MODE=model. Keep secrets server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=3000
# Comma-separated verified Supabase Auth user UUIDs; empty blocks every actual model call.
OPENAI_ALLOWED_USER_IDS=
