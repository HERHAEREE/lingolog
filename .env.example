# Public project configuration only. Never add admin/service-role/model keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Enable only after deploying and validating authentication + SQL limits.
EXPO_PUBLIC_SERVER_CORRECTION_ENABLED=false
EXPO_PUBLIC_SERVER_CORRECTION_MODE=mock
